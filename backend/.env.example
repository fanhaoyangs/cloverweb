# CloverWeb 后端环境变量模板（复制为 .env 后填写，.env 不进 git）

# Django
DJANGO_SECRET_KEY=change-me-in-prod

# PostgreSQL（dev 用 SQLite，无需配置）
DB_NAME=cloverweb
DB_USER=cloverweb
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# 腾讯云 COS（UEditorPlus 上传，必填才能传图）
# 桶名格式：<名称>-<APPID>，如 images-community-1250000000
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-shanghai
COS_BUCKET=
# CDN 域名（桶绑定的自定义域名，无则填 https://<bucket>.cos.<region>.myqcloud.com）
COS_BASE_URL=https://images.communitygarden.org.cn

# 站点
SITE_URL=https://communitygarden.org.cn

# 飞书 OAuth（CMS 内部登录 + 文档导入，复用同一套 APP_ID/SECRET）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=https://communitygarden.org.cn/api/auth/feishu/callback/
# 白名单（两项独立生效，配了哪个校验哪个；都留空 = 全放行）
# 账号级：open_id 逗号分隔
FEISHU_ALLOWED_OPEN_IDS=
# 租户级：企业 tenant_key 逗号分隔（企业内所有成员可登录）
FEISHU_ALLOWED_TENANT_KEYS=

# 飞书文档导入（user OAuth 模式，复用上面的 APP_ID/SECRET）
# 飞书开放平台后台需做三件事：
# 1. 开通权限：offline_access / docx:document:readonly / drive:drive:readonly / wiki:wiki:readonly
# 2. 安全设置中开启「刷新 user_access_token」能力（否则拿不到 refresh_token）
# 3. 发布应用版本使权限生效
# 用户在 CMS 导入文档前需通过「前往授权」完成一次带文档权限的 OAuth 授权
# 授权后以用户身份访问文档，无需将文档共享给应用
# 可选：文件夹 token（用户需有该文件夹访问权限），配置后 CMS 可浏览文件夹内文档列表
FEISHU_FOLDER_TOKEN=
