# CloverWeb 后端环境变量模板（复制为 .env 后填写，.env 不进 git）

# Django
DJANGO_SECRET_KEY=change-me-in-prod

# PostgreSQL（dev 用 SQLite，无需配置）
DB_NAME=cloverweb
DB_USER=cloverweb
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# 腾讯云 COS（UEditorPlus 上传，必填才能传图）
# 桶名格式：<名称>-<APPID>，如 images-community-1250000000
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-shanghai
COS_BUCKET=
# CDN 域名（桶绑定的自定义域名，无则填 https://<bucket>.cos.<region>.myqcloud.com）
COS_BASE_URL=https://images.communitygarden.org.cn

# 站点
SITE_URL=https://communitygarden.org.cn

# 飞书 OAuth（CMS 内部登录）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=https://communitygarden.org.cn/api/auth/feishu/callback/
FEISHU_ALLOWED_OPEN_IDS=
