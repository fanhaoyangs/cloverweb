# ============================================
# 腾讯云COS配置
# ============================================
# 请在腾讯云控制台获取：https://console.cloud.tencent.com/
# 用户中心 → 访问密钥 → API密钥

COS_SECRET_ID=your_secret_id_here
COS_SECRET_KEY=your_secret_key_here

# 地域：ap-shanghai（上海）、ap-beijing（北京）、ap-guangzhou（广州）等
COS_REGION=ap-shanghai

# 存储桶名称：格式为 桶名-APPID，如 blog-images-1234567890
COS_BUCKET_NAME=your-bucket-name-1234567890

# 自定义域名：如果使用CDN加速域名，填入完整域名
# 例如：images.communitygarden.org.cn
CUSTOM_DOMAIN=images.communitygarden.org.cn

# ============================================
# Flask配置
# ============================================
SECRET_KEY=your-secret-key-change-in-production
FLASK_DEBUG=False

# 数据库配置（可选，默认使用SQLite）
# DATABASE_URI=sqlite:///posts.db
# DATABASE_URI=mysql+pymysql://user:password@localhost/blog

# ============================================
# 飞书开放平台配置
# ============================================
# 请在飞书开放平台创建应用后获取：https://open.feishu.cn/

FEISHU_APP_ID=your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here

# 重定向URI：用户授权后的回调地址
# 格式：https://your-domain.com/admin/feishu/callback
FEISHU_REDIRECT_URI=https://your-domain.com/admin/feishu/callback

# 应用权限范围（用空格分隔，需要与飞书开放平台配置一致）
# drive:drive:readonly（云文档只读）
# docs:document.content:read（查看云文档内容）
# docs:document.media:download（下载云文档中的图片和附件）
# docx:document:readonly（查看新版文档）
# auth:user_access_token:read（获取用户令牌）
FEISHU_SCOPES=drive:drive:readonly docs:document.content:read docs:document.media:download docx:document:readonly auth:user_access_token:read
