# /etc/systemd/system/blog-system.service
# 博客系统服务配置

[Unit]
Description=Blog System Web Application
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/blog_system
Environment="PATH=/var/www/blog_system/venv/bin"
Environment="FLASK_ENV=production"
Environment="SECRET_KEY=your-secret-key-here-change-in-production"
Environment="COS_SECRET_ID=your-cos-secret-id"
Environment="COS_SECRET_KEY=your-cos-secret-key"
Environment="COS_BUCKET_NAME=blog-images"
Environment="COS_REGION=ap-shanghai"
Environment="CUSTOM_DOMAIN=images.communitygarden.org.cn"

ExecStart=/var/www/blog_system/venv/bin/gunicorn \
    --config /var/www/blog_system/gunicorn.conf.py \
    app:app

ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true

Restart=always
RestartSec=5

# 日志配置
StandardOutput=append:/var/log/blog_system/access.log
StandardError=append:/var/log/blog_system/error.log

[Install]
WantedBy=multi-user.target
